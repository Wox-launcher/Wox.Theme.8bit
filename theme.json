      "theme_name": "8-Bit Night",
      "theme_description": "A navy pixel-art launcher with stepped frames and ice-blue, mint, and gold accents."
    },
    "zh_CN": {
      "theme_name": "像素夜航",
      "theme_description": "深蓝底色、阶梯形像素边框，点缀冰蓝、薄荷绿和金黄。"
    },
    "ru_RU": {
      "theme_name": "8-битная ночь",
      "theme_description": "Тёмно-синяя тема в пиксельном стиле со ступенчатой рамкой и голубыми, мятными и золотыми акцентами."
    },
    "pt_BR": {
      "theme_name": "Noite de 8 bits",
      "theme_description": "Tema azul-marinho em pixel art com moldura escalonada e detalhes em azul-gelo, verde-menta e dourado."
    },
    "ko_KR": {
      "theme_name": "8비트의 밤",
      "theme_description": "계단형 픽셀 테두리와 얼음빛 파랑, 민트색, 금색으로 꾸민 짙은 남색 테마입니다."
    },
    "ja_JP": {
      "theme_name": "8ビットの夜",
      "theme_description": "濃紺に階段状のドット枠を重ね、アイスブルー、ミント、金色を添えたテーマ。"
    }
  },
